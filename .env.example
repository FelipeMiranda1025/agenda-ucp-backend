# =============================================
# Backend API — Agenda Docente UCP
# Copia este archivo a `.env` y ajusta los valores.
# =============================================

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Base de datos PostgreSQL ────────────────────────────────
# El "*" en la contraseña va URL-encoded como %2A
DATABASE_URL=postgres://admin:1234Ucp*%2A@localhost:5432/agendadocentedb

# ── Autenticación ───────────────────────────────────────────
# Genera un secreto fuerte: openssl rand -base64 32
JWT_SECRET=cambia-esto-en-produccion

# ── CORS ────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma). Usar "*" solo en dev.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# URL pública del frontend (para links de recuperación de contraseña)
# Producción Render: https://ucp-agenda-frontend.onrender.com (sin barra final)
FRONTEND_URL=http://localhost:8080

# ── Uploads ─────────────────────────────────────────────────
# Carpeta donde multer guarda archivos. En docker-compose se monta
# como volumen persistente.
UPLOADS_DIR=/var/app/uploads
MAX_UPLOAD_MB=20

# ── SMTP (recuperación de contraseña, agenda aprobada, notificaciones) ───────
# Obligatorio en Render para enviar correos. Sin SMTP_USER/SMTP_PASS el API
# guarda la aprobación pero omite el email al docente.
# Para Gmail: usar una "App Password", no la contraseña real.
# En producción: usar el servidor SMTP institucional UCP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Agenda Docente UCP <no-reply@ucp.edu.co>

# ── Google Gemini (lineamientos PDF) ───────────────────────
# API key desde https://aistudio.google.com/apikey
# Sin clave: el backend usa extracción por regex (fallback).
GEMINI_API_KEY=

# ── Correos HTML (colores UCP) ───────────────────────────────
# green = verde institucional (#00804E, default, igual que la app)
# red   = rojo institucional (#8C1D18)
EMAIL_BRAND_THEME=green
